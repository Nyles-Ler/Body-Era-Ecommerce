<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">

      <div class="card bodyera-detail-card">
        <div class="card-body p-4">

          <p class="bodyera-section-label mb-2">
            WELCOME BACK
          </p>

          <h1 class="h2 fw-bold mb-2">
            Login
          </h1>

          <p class="text-muted mb-4">
            Sign in to your BodyEra account.
          </p>

          <%= form_for(resource,
              as: resource_name,
              url: session_path(resource_name)) do |f| %>

            <div class="mb-3">
              <%= f.label :email,
                  class: "form-label fw-bold" %>

              <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :password,
                  class: "form-label fw-bold" %>

              <%= f.password_field :password,
                  autocomplete: "current-password",
                  class: "form-control" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="form-check mb-4">
                <%= f.check_box :remember_me,
                    class: "form-check-input" %>

                <%= f.label :remember_me,
                    class: "form-check-label" %>
              </div>
            <% end %>

            <%= f.submit "Login",
                class: "btn bodyera-button w-100 py-2" %>

          <% end %>

          <div class="text-center mt-4">
            <span class="text-muted">
              Don't have an account?
            </span>

            <%= link_to "Create Account",
                new_user_registration_path,
                class: "bodyera-link text-decoration-none fw-bold ms-1" %>
          </div>

          <div class="text-center mt-2">
            <%= link_to "Forgot your password?",
                new_user_password_path,
                class: "bodyera-link text-decoration-none" %>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>