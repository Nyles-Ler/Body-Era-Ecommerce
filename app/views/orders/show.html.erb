<!-- Feature 3.1.3 - Completed order invoice -->

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <p class="bodyera-category-label mb-2">
      Order Confirmation
    </p>

    <h1 class="mb-1">
      Invoice #<%= @order.id %>
    </h1>

    <p class="text-muted mb-0">
      Placed <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %>
    </p>
  </div>

  <span class="badge bodyera-badge fs-6">
    <%= @order.order_status.titleize %>
  </span>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card bodyera-detail-card">
      <div class="card-body">
        <h2 class="h4 mb-3">Order Items</h2>

        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Product</th>
                <th>Variant</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th class="text-end">Line Total</th>
              </tr>
            </thead>

            <tbody>
              <% @order.order_items.each do |item| %>
                <tr>
                  <td><%= item.product.name %></td>

                  <td>
                    <%= item.product_variant.size %> /
                    <%= item.product_variant.colour %>
                  </td>

                  <td><%= item.quantity %></td>

                  <td>
                    <%= number_to_currency(item.unit_price) %>
                  </td>

                  <td class="text-end">
                    <%= number_to_currency(item.line_total) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card bodyera-detail-card mb-4">
      <div class="card-body">
        <h2 class="h4 mb-3">Invoice Summary</h2>

        <div class="d-flex justify-content-between mb-2">
          <span>Subtotal</span>
          <span><%= number_to_currency(@order.subtotal) %></span>
        </div>

        <% if @order.gst_amount.positive? %>
          <div class="d-flex justify-content-between mb-2">
            <span>
              GST (<%= number_to_percentage(@order.gst_rate * 100, precision: 2) %>)
            </span>

            <span><%= number_to_currency(@order.gst_amount) %></span>
          </div>
        <% end %>

        <% if @order.pst_amount.positive? %>
          <div class="d-flex justify-content-between mb-2">
            <span>
              PST (<%= number_to_percentage(@order.pst_rate * 100, precision: 3) %>)
            </span>

            <span><%= number_to_currency(@order.pst_amount) %></span>
          </div>
        <% end %>

        <% if @order.hst_amount.positive? %>
          <div class="d-flex justify-content-between mb-2">
            <span>
              HST (<%= number_to_percentage(@order.hst_rate * 100, precision: 2) %>)
            </span>

            <span><%= number_to_currency(@order.hst_amount) %></span>
          </div>
        <% end %>

        <hr>

        <div class="d-flex justify-content-between fs-5 fw-bold">
          <span>Total</span>
          <span><%= number_to_currency(@order.total_amount) %></span>
        </div>
      </div>
    </div>

    <div class="card bodyera-detail-card">
      <div class="card-body">
        <h2 class="h4 mb-3">Shipping Information</h2>

        <p class="fw-bold mb-1">
          <%= @order.user.first_name %>
          <%= @order.user.last_name %>
        </p>

        <p class="mb-0">
          <%= @order.address.street_address %><br>
          <%= @order.address.city %>,
          <%= @order.address.province %><br>
          <%= @order.address.postal_code %><br>
          <%= @order.address.country %>
        </p>
      </div>
    </div>
  </div>
</div>

<div class="mt-4">
  <%= link_to "Continue Shopping",
      products_path,
      class: "btn bodyera-button" %>
</div>