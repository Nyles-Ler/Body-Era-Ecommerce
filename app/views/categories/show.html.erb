<!-- Category Show Page -->
<!-- Displays all active products belonging to one category -->

<div class="container-xl py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <p class="bodyera-category-label mb-2">
        Product Category
      </p>

      <h1 class="mb-1">
        <%= @category.name %>
      </h1>

      <p class="text-muted mb-0">
        <%= @category.description %>
      </p>
    </div>

    <span class="badge bodyera-badge fs-6">
      <%= pluralize(@products.count, "product") %>
    </span>
  </div>

  <% if @products.any? %>
  <div class="row g-4">
    <%= render partial: "products/product_card",
              collection: @products,
              as: :product %>
  </div>
  <% else %>
    <div class="text-center py-5">
      <h2 class="h4">No products available</h2>

      <p class="text-muted">
        This category does not currently contain any active products.
      </p>

      <%= link_to "View All Categories",
          categories_path,
          class: "btn bodyera-button" %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to "Back to Categories",
        categories_path,
        class: "btn btn-outline-secondary" %>
  </div>

</div>