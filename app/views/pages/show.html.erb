<!-- Displays editable website page content -->

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-xl-10">

      <p class="bodyera-section-label mb-2">
        BODYERA FITNESS
      </p>

      <h1 class="fw-bold mb-4">
        <%= @page.title %>
      </h1>

      <div class="row g-4">

        <!-- Editable Page Content -->
        <div class="col-lg-8">
          <div class="card bodyera-detail-card h-100">
            <div class="card-body p-4 p-lg-5">

              <div class="fs-5 text-muted lh-lg">
                <%= simple_format(@page.content) %>
              </div>

            </div>
          </div>
        </div>

        <!-- Shared BodyEra Brand Panel -->
        <div class="col-lg-4">
          <div class="card bodyera-detail-card h-100">
            <div class="card-body p-4">

              <h2 class="h4 fw-bold mb-4">
                BodyEra Fitness
              </h2>

              <div class="mb-4">
                <i class="bi bi-lightning-charge fs-3 bodyera-link"></i>

                <h3 class="h6 fw-bold mt-2">
                  Performance
                </h3>

                <p class="text-muted mb-0">
                  Apparel designed for training, movement, and everyday wear.
                </p>
              </div>

              <div class="mb-4">
                <i class="bi bi-shield-check fs-3 bodyera-link"></i>

                <h3 class="h6 fw-bold mt-2">
                  Quality
                </h3>

                <p class="text-muted mb-0">
                  Built around comfort, durability, and attention to detail.
                </p>
              </div>

              <div>
                <i class="bi bi-people fs-3 bodyera-link"></i>

                <h3 class="h6 fw-bold mt-2">
                  Community
                </h3>

                <p class="text-muted mb-0">
                  Made for people committed to building their own era.
                </p>
              </div>

            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>